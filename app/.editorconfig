# Coding conventions for every editor and IDE (https://editorconfig.org). See docs/coding-conventions.md.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
max_line_length = 120

[*.{yaml,yml,json,js,css,html}]
indent_size = 2

[*.rego]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
