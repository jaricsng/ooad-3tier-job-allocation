# Job Allocation: application settings (CONFIGURATION AS CODE).
# GENERATED from edu.ooad.joballoc.config.Setting; ConfigurationTest fails if this file drifts.
# Copy to .env (git-ignored) or export as environment variables. Values shown are the defaults.
# Production rules (secure cookies, no demo data, no default password) are enforced by
# policy/config.rego: make policy

# Deployment profile: dev or prod (prod is checked by policy/config.rego) [dev or prod]
APP_PROFILE=dev

# Address the HTTP server listens on (0.0.0.0 = all interfaces) [an IP address or host name]
APP_BIND=127.0.0.1

# HTTP port (0 = any free port, used by tests) [0-65535]
APP_PORT=8080

# Mark the session cookie Secure and send HSTS (required behind HTTPS) [true or false]
COOKIE_SECURE=false

# Load demo jobs, workers and users at start-up [true or false]
APP_DEMO_DATA=true

# Where data is stored: a JDBC URL (the prefix selects PostgreSQL or MySQL) or memory: (no database) [jdbc:postgresql://host:port/db, jdbc:mysql://host:port/db or memory:]
DB_URL=jdbc:postgresql://localhost:5432/joballoc

# Database user [a non-empty user name]
DB_USER=joballoc

# Database password (inject from a secret store outside dev) [any] SECRET
DB_PASSWORD=joballoc

# Maximum number of pooled database connections [1-100]
DB_POOL_SIZE=10

# Public URL users reach the app on; SSO redirect URIs are built from it [http(s)://host[:port] without a trailing path]
SSO_BASE_URL=http://127.0.0.1:8080

# Unknown verified SSO email: none (deny) or viewer (create a read-only account) [none or viewer]
SSO_AUTO_PROVISION=none

# Google OAuth client id (empty = Google sign-in off) [any]
SSO_GOOGLE_CLIENT_ID=

# Google OAuth client secret (inject from a secret store) [any] SECRET
SSO_GOOGLE_CLIENT_SECRET=

# Microsoft Entra application (client) id (empty = off) [any]
SSO_MICROSOFT_CLIENT_ID=

# Microsoft Entra client secret (inject from a secret store) [any] SECRET
SSO_MICROSOFT_CLIENT_SECRET=

# Entra tenant: a tenant id, organizations, or common [a tenant id or domain, organizations or common]
SSO_MICROSOFT_TENANT=organizations

# Sign in with Apple Services ID (empty = off) [any]
SSO_APPLE_CLIENT_ID=

# Apple developer Team ID [10 characters A-Z0-9]
SSO_APPLE_TEAM_ID=

# Key ID of the Sign in with Apple private key [10 characters A-Z0-9]
SSO_APPLE_KEY_ID=

# Path to the Apple .p8 private key file (never commit the file) [a file path]
SSO_APPLE_PRIVATE_KEY_FILE=

# Button label of the generic OpenID Connect provider [a label]
SSO_OIDC_NAME=Single sign-on

# Issuer URL of a generic OpenID Connect provider (Okta, Keycloak...; empty = off) [an https issuer URL]
SSO_OIDC_ISSUER=

# Client id at the generic OpenID Connect provider [any]
SSO_OIDC_CLIENT_ID=

# Client secret at the generic OpenID Connect provider [any] SECRET
SSO_OIDC_CLIENT_SECRET=

# Host ports for the database containers (read by compose.yaml and the Makefile, not by the app)
DB_PORT=5432
MYSQL_PORT=3306
