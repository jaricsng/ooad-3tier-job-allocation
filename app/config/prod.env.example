# Job Allocation: production settings TEMPLATE (CONFIGURATION AS CODE).
# Checked by policy/config.rego (make policy). Secrets are NOT stored here:
# DB_PASSWORD is left empty and injected at deploy time from a secret store
# (for example Docker/Kubernetes secrets, AWS Secrets Manager or HashiCorp Vault).
APP_PROFILE=prod
APP_BIND=0.0.0.0
APP_PORT=8080
COOKIE_SECURE=true
APP_DEMO_DATA=false
# Verified TLS is required in prod (policy P7). For MySQL use:
# DB_URL=jdbc:mysql://db.internal:3306/joballoc?sslMode=VERIFY_IDENTITY
DB_URL=jdbc:postgresql://db.internal:5432/joballoc?sslmode=verify-full
DB_USER=joballoc_app
DB_PASSWORD=
DB_POOL_SIZE=20
# Single sign-on (docs/sso.md). Client ids are not secret; client secrets are injected at deploy time.
SSO_BASE_URL=https://jobs.example.edu
SSO_AUTO_PROVISION=none
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_MICROSOFT_TENANT=organizations
