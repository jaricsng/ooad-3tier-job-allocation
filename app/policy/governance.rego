# GOVERNANCE AS CODE: rules about what the project is made of and how it is documented.
# Input: target/security/governance.json, generated by security/sbom.py (make governance).
package governance

import rego.v1

# Licences this project may ship. Copyleft is allowed only where its exception makes it compatible.
allowed_licences := {"MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "GPL-2.0-only WITH Universal-FOSS-exception-1.0"}

# Licences allowed only for test-time components that are never shipped.
licences_for_tests_only := {"EPL-1.0", "EPL-2.0"}

required_files := {
	"LICENSE", "README.md", "SECURITY.md", "THIRD_PARTY_NOTICES.md", ".gitleaks.toml",
	"docs/runbook.md", "docs/user-guide.md", "docs/architecture.md", "security/components.csv",
	"docs/sso.md", "docs/security-testing.md", "docs/ai-assisted-engineering.md",
}

# Sections the AI-assisted engineering practice must keep (G8).
ai_practice_sections := {"Risk register", "Human review checklist", "Disclosure and provenance"}

jar_components := {c.file | some c in input.components; endswith(c.file, ".jar")}

# G1: every jar in lib/ is pinned by SHA-256 (supply chain), and every pin has a jar.
deny contains msg if {
	some jar in input.jars_in_lib
	not jar in {p | some p in input.pinned_jars}
	msg := sprintf("G1: lib/%s is not pinned in lib.sha256", [jar])
}

deny contains msg if {
	some pin in input.pinned_jars
	not pin in {j | some j in input.jars_in_lib}
	msg := sprintf("G1: lib.sha256 pins %s, which is not in lib/", [pin])
}

# G2: every pinned jar is declared as a component (so it appears in the SBOM and the SCA scan).
deny contains msg if {
	some pin in input.pinned_jars
	not pin in jar_components
	msg := sprintf("G2: %s is not listed in security/components.csv (SBOM and vulnerability scan would miss it)", [pin])
}

# G3: licences are on the approved list; test-only licences only for test-scope components.
deny contains msg if {
	some c in input.components
	not c.license in allowed_licences
	not allowed_for_tests_only(c)
	msg := sprintf("G3: %s uses licence %q, which is not approved for scope %s", [c.name, c.license, c.scope])
}

allowed_for_tests_only(c) if {
	c.scope == "test"
	c.license in licences_for_tests_only
}

# G4: every component is acknowledged in THIRD_PARTY_NOTICES.md (attribution obligations).
deny contains msg if {
	some c in input.components
	not contains(lower(input.notices_text), lower(display_name(c)))
	msg := sprintf("G4: %s (%s) is missing from THIRD_PARTY_NOTICES.md", [c.name, display_name(c)])
}

display_name(c) := n if {
	names := {
		"postgresql": "pgjdbc", "mysql-connector-j": "Connector/J", "jackson-core": "Jackson",
		"jackson-databind": "Jackson", "jackson-annotations": "Jackson", "jackson-datatype-jsr310": "Jackson Datatype JSR-310",
		"junit": "JUnit", "hamcrest-core": "Hamcrest", "bootstrap": "Bootstrap",
	}
	n := object.get(names, c.name, c.name)
}

# G5: a copyleft component must carry the explanation of its exception in the notices.
deny contains msg if {
	some c in input.components
	contains(c.license, "GPL")
	not contains(input.notices_text, "Universal FOSS Exception")
	msg := sprintf("G5: %s is GPL-licensed but THIRD_PARTY_NOTICES.md does not explain its exception", [c.name])
}

# G6: the documents and policies every release needs are present.
deny contains msg if {
	some f in required_files
	not f in {x | some x in input.files}
	msg := sprintf("G6: required file %s is missing", [f])
}

# G7: every database product has the same migration versions (no product left behind).
deny contains msg if {
	some f in input.files
	startswith(f, "src/main/resources/db/migration/postgresql/")
	script := substring(f, count("src/main/resources/db/migration/postgresql/"), -1)
	not concat("", ["src/main/resources/db/migration/mysql/", script]) in {x | some x in input.files}
	msg := sprintf("G7: migration %s exists for PostgreSQL but not for MySQL", [script])
}

deny contains msg if {
	some f in input.files
	startswith(f, "src/main/resources/db/migration/mysql/")
	script := substring(f, count("src/main/resources/db/migration/mysql/"), -1)
	not concat("", ["src/main/resources/db/migration/postgresql/", script]) in {x | some x in input.files}
	msg := sprintf("G7: migration %s exists for MySQL but not for PostgreSQL", [script])
}

# G8: the AI-assisted engineering practice keeps its risk register, review checklist and
# disclosure rules, and every pull request is asked to disclose AI assistance.
deny contains msg if {
	some section in ai_practice_sections
	not section_present(section)
	msg := sprintf("G8: docs/ai-assisted-engineering.md has no section on %q", [section])
}

deny contains msg if {
	not contains(input.pr_template_text, "AI-assisted")
	msg := "G8: no .github/pull_request_template.md (repository root) asking for AI-assistance disclosure"
}

section_present(section) if {
	some heading in input.ai_practice_headings
	contains(heading, section)
}
