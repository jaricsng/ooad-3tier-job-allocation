@startuml
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
LAYOUT_WITH_LEGEND()
title Components — Job Allocation web application (C4 level 3, as built after refactoring)

Container(browser, "Web browser", "HTML + CSS")
System_Ext(client, "Integration client", "REST consumer (OpenAPI 3.1 contract)")
ContainerDb(db, "Job Allocation database", "PostgreSQL 16 or MySQL 8.4 (not used with DB_URL=memory:)")
System_Ext(idp, "Identity providers", "Google, Microsoft, Apple (OIDC)")

Container_Boundary(app, "Job Allocation web application (Java 21)") {
  Component(hx, "HTTP adapter", "web.http.HttpExchangeAdapter", "Adapter: JDK HttpExchange ⇄ Request / Response")
  Component(fc, "Front Controller", "web.http: FrontController, Router, ErrorMapper", "Security headers, authentication, CSRF, correlation ID, Problem Details")
  Component(pages, "Board & Login controllers + views", "web.controller, web.view", "Job Allocation Board; one loadBoard call per page; POST-Redirect-GET")
  Component(api, "REST API controller", "web.controller.ApiController, web.dto", "/api/v1 JSON, ETag / If-Match; Idempotency-Key decorator on POST")
  Component(auth, "Authentication", "business.security.AuthService", "PBKDF2 passwords, lockout after 5 failures")
  Component(facade, "AllocationService facade + proxy", "business: SecuredTransactionalProxy, business.proxy", "Interceptor chain: role check → exception translation → transaction")
  Component(svc, "Allocation use cases + domain", "business.AllocationServiceImpl, domain.*", "Allocate, auto-allocate, unassign; Worker/Job enforce the rules")
  Component(pol, "Policy engine", "business.policy", "Strategy: SKILL_MATCH, LEAST_LOADED, FIRST_FIT")
  Component(ev, "Event bus", "business.event", "Observer: audit and metrics listeners")
  Component(ports, "Ports", "business.port", "TransactionRunner, DatabaseHealth")
  Component(adapters, "Persistence adapters", "adapter.*", "TransactionManagerAdapter, JdbcDatabaseHealthAdapter")
  Component(dao, "Data access", "persistence.dao + persistence.ormdao", "DAO interfaces, DataAccessException hierarchy, AbstractOrmDAO")
  Component(orm, "Mini ORM", "persistence.orm + mapping", "Metadata mapping, identity map, transactions, connection pool, migrations")
  Component(dialect, "SQL dialects", "persistence.dialect", "Strategy per database product, chosen from DB_URL by DialectFactory")
  Component(storage, "Storage selection", "storage: StorageFactory, RelationalStorage, InMemoryStorage", "Abstract Factory: DAOs + transactions + health that belong together, chosen from DB_URL")
  Component(mem, "In-memory storage", "persistence.memory + InMemoryTransactionAdapter", "Guarded DAOs; transactions = lock + snapshot (Memento)")
  Component(sso, "Single sign-on", "web.sso + SsoController", "OIDC code flow + PKCE; ID-token verification")
}

Rel(browser, hx, "HTTP", ":8080")
Rel(client, hx, "JSON", "Basic auth")
Rel(hx, fc, "Request")
Rel(fc, pages, "Dispatches")
Rel(fc, api, "Dispatches")
Rel(fc, auth, "Authenticates")
Rel(pages, facade, "Calls")
Rel(api, facade, "Calls")
Rel(facade, svc, "Delegates")
Rel(facade, ports, "Transactions via")
Rel(svc, pol, "Ranks workers")
Rel(svc, ev, "Publishes JobAllocated / JobUnassigned")
Rel(svc, dao, "Loads and saves")
Rel(ev, dao, "Appends audit")
Rel(auth, dao, "Reads users")
Rel_L(adapters, ports, "Implement")
Rel(adapters, orm, "Adapt TransactionManager")
Rel(dao, orm, "Uses")
Rel(dao, dialect, "Asks for product differences")
Rel(orm, dialect, "Selects from DB_URL")
Rel(orm, db, "SQL", "JDBC")
Rel(storage, orm, "jdbc:postgresql / jdbc:mysql")
Rel(storage, mem, "memory:")
Rel(fc, sso, "/sso/*")
Rel(sso, auth, "authenticateExternal")
Rel(sso, idp, "OIDC", "HTTPS")
@enduml
