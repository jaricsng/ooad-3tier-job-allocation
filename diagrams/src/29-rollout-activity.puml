@startuml
!include style.iuml
skinparam activityBackgroundColor #F3F6FA
skinparam activityBorderColor #1E4E8C
skinparam activityDiamondBackgroundColor #FFF6E5
skinparam activityDiamondBorderColor #D9822B
mainframe act Release, migrate, roll back
title Release, migration and rollback — UML 2.5.1 activity diagram (runbook §10)

|Release engineer|
start
:make check\n(conventions, unit tests, policies, API lint);
:make test-int-all\n(PostgreSQL, MySQL, in-memory);
if () then ([a gate or test failed])
  :fix the build;
  stop
else ([else])
endif
:back up the database (runbook §6);
:make db-status;
if () then ([a script is CHANGED or UNKNOWN])
  :restore the edited script, or deploy\nthe build that matches the database;
  stop
else ([else: only APPLIED or PENDING])
endif
:optional rehearsal:\nTARGET_DB_URL=memory: make db-copy;
:stop the app;
|Database|
:make db-migrate;
if () then ([migration failed])
  if () then ([product = PostgreSQL])
    :script rolled back automatically\n(one transaction);
  else ([product = MySQL])
    :restore the backup\n(DDL commits per statement);
  endif
  |Release engineer|
  :start the previous version;
  stop
else ([else])
endif
|Release engineer|
:start the new version;
:make smoke and sign in once;
if () then ([smoke test passed])
  :release done;
  stop
else ([else])
  if () then ([migrations were expand-only])
    :start the previous version\n(schema stays: compatible);
  else ([else: contract change])
    :restore the backup,\nthen start the previous version;
  endif
  stop
endif
@enduml
